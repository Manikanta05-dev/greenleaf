# ── Database ──────────────────────────────────────────────────────────────
# For local dev: point at your local Postgres instance
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/greenleaf"

# For Docker Compose: the service name "postgres" is the host
# DATABASE_URL="postgresql://postgres:yourpassword@postgres:5432/greenleaf"

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a strong random secret:  node -e "console.log(require('crypto').randomBytes(40).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ── App URL ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Razorpay ──────────────────────────────────────────────────────────────
# Get your keys from https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for testing, rzp_live_* for production
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"

# ── Docker Compose extras (used only in docker-compose.yml) ───────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=greenleaf
